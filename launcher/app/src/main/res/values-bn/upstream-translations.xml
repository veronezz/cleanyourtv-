    <string name="card_prompt_body">%1$s আপনার হোম স্ক্রিনে একটি কার্ড দেখাতে পারে। লুকিয়ে রাখলে অ্যাপের সাধারণ টাইল যেমন আছে তেমনই থাকবে।</string>
    <string name="card_prompt_names">কার্ডটির নাম \'%1$s\'। অ্যাপটির নাম \'%2$s\'।</string>
