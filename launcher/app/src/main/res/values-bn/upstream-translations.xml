    <string name="home_settings">ডিফল্ট হোম বেছে নিন</string>
    <string name="home_settings_help">CleanYourTV-কে আর হোম হিসেবে ব্যবহার না করতে আপনার আগের হোম বেছে নিন, আবার ফিরতে CleanYourTV বেছে নিন। আগের লঞ্চারটি চালু থাকতে হবে এবং আপনার টিভিতে হোম বেছে নেওয়ার ব্যবস্থা থাকতে হবে; সেটি বন্ধ করা থাকলে আগে রিস্টোর স্ক্রিপ্ট চালান।</string>
    <string name="input_key_service_description">রিমোটের ইনপুট বোতাম চাপলে ইনপুট বদলানোর তালিকা খোলে।</string>
